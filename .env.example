# PostgreSQL — single instance, two databases (auth_db and order_db are
# created automatically by docker/postgres/init-databases.sh on first start)
POSTGRES_USER=
POSTGRES_PASSWORD=
# POSTGRES_DB is the default system database used by the healthcheck;
POSTGRES_DB=postgres

# Auth Service
SPRING_AUTH_SERVICE_DATASOURCE_URL=jdbc:postgresql://db:5432/auth_db
SPRING_AUTH_SERVICE_DATASOURCE_USERNAME=
SPRING_AUTH_SERVICE_DATASOURCE_PASSWORD=

# Order Service
SPRING_ORDER_SERVICE_DATASOURCE_URL=jdbc:postgresql://db:5432/order_db
SPRING_ORDER_SERVICE_DATASOURCE_USERNAME=
SPRING_ORDER_SERVICE_DATASOURCE_PASSWORD=
